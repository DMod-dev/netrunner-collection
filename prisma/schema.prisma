// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  name     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image             UserImage?
  password          Password?
  collectionEntries CollectionEntry[]
  variants          Variant[]
  preferredArt      PreferredPrinting[]
  roles             Role[]
  sessions          Session[]
  connections       Connection[]
  passkey           Passkey[]
  sharesGiven       CollectionShare[]   @relation("CollectionShareOwner")
  sharesReceived    CollectionShare[]   @relation("CollectionShareViewer")
  decks             Deck[]
}

model UserImage {
  id        String  @id @default(cuid())
  altText   String?
  objectKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Session {
  id             String   @id @default(cuid())
  expirationDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  // non-unique foreign key
  @@index([userId])
}

model Permission {
  id          String @id @default(cuid())
  action      String // e.g. create, read, update, delete
  entity      String // e.g. note, user, etc.
  access      String // e.g. own or any
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]

  @@unique([action, entity, access])
}

model Role {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Verification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// The type of verification, e.g. "email" or "phone"
  type String

  /// The thing we're trying to verify, e.g. a user's email or phone number
  target String

  /// The secret key used to generate the otp
  secret String

  /// The algorithm used to generate the otp
  algorithm String

  /// The number of digits in the otp
  digits Int

  /// The number of seconds the otp is valid for
  period Int

  /// The valid characters for the otp
  charSet String

  /// When it's safe to delete this verification
  expiresAt DateTime?

  @@unique([target, type])
}

model Connection {
  id           String @id @default(cuid())
  providerName String
  providerId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  @@unique([providerName, providerId])
}

model Passkey {
  id             String   @id
  aaguid         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publicKey      Bytes
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  webauthnUserId String
  counter        BigInt
  deviceType     String // 'singleDevice' or 'multiDevice'
  backedUp       Boolean
  transports     String? // Stored as comma-separated values

  @@index(userId)
}

// ---------------------------------------------------------------------------
// Card data mirrored from NetrunnerDB (api.netrunnerdb.com/api/v3/public).
// IDs are NRDB's own ids so we can upsert on every sync. Never edit these by
// hand; run `npm run sync:nrdb` instead.
// ---------------------------------------------------------------------------

model Faction {
  id        String   @id // e.g. "anarch"
  name      String
  sideId    String // "corp" | "runner"
  isMini    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  cards Card[]
}

model CardType {
  id        String   @id // e.g. "event"
  name      String
  updatedAt DateTime @updatedAt

  cards Card[]
}

model CardCycle {
  id          String    @id // e.g. "system_gateway"
  name        String
  position    Int
  dateRelease DateTime?
  releasedBy  String?
  updatedAt   DateTime  @updatedAt

  sets CardSet[]
}

model CardSet {
  id          String    @id // e.g. "system_gateway"
  name        String
  position    Int
  size        Int
  setTypeId   String // "core" | "deluxe" | "data_pack" | "booster_pack" | ...
  dateRelease DateTime?
  releasedBy  String?
  updatedAt   DateTime  @updatedAt

  cycle   CardCycle @relation(fields: [cycleId], references: [id])
  cycleId String

  printings Printing[]

  @@index([cycleId])
}

model Card {
  id              String   @id // e.g. "hedge_fund"
  title           String
  strippedTitle   String // ascii-only title, used for search
  sideId          String
  text            String?
  strippedText    String?
  displaySubtypes String?
  isUnique        Boolean  @default(false)
  deckLimit       Int
  cost            String?
  influenceCost   Int?
  /// comma-wrapped format ids the card is currently legal in, e.g. ",standard,startup,eternal,"
  /// (wrapped so `contains: ",standard,"` matches exactly)
  legalFormats    String   @default(",")
  /// identities only
  minimumDeckSize Int?
  /// identities only; null on an identity means no limit (e.g. Ampère)
  influenceLimit  Int?
  /// agendas only
  agendaPoints    Int?
  /// comma-wrapped NRDB card_subtype_ids, e.g. ",alliance,region," (wrapped like legalFormats)
  subtypes        String   @default(",")
  updatedAt       DateTime @updatedAt

  faction   Faction  @relation(fields: [factionId], references: [id])
  factionId String
  type      CardType @relation(fields: [typeId], references: [id])
  typeId    String

  printings     Printing[]
  preferredArt  PreferredPrinting[]
  deckCards     DeckCard[]
  identityDecks Deck[]              @relation("DeckIdentity")

  @@index([strippedTitle])
  @@index([sideId, factionId])
  @@index([typeId])
}

model Printing {
  id          String    @id // NRDB printing code, e.g. "30075"
  position    Int // position within the set
  quantity    Int // copies of this card in one product
  illustrator String?
  flavor      String?
  dateRelease DateTime?
  imageSmall  String?
  imageLarge  String?
  isLatest    Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  card   Card    @relation(fields: [cardId], references: [id])
  cardId String
  set    CardSet @relation(fields: [setId], references: [id])
  setId  String

  collectionEntries CollectionEntry[]
  variants          Variant[]
  preferredArt      PreferredPrinting[]

  @@index([cardId])
  @@index([setId, position])
}

/// A NetrunnerDB format (standard, startup, eternal...) and the card pool
/// and ban/points list currently in force for it.
model Format {
  id                  String   @id // e.g. "standard"
  name                String
  activeCardPoolId    String?
  activeSnapshotId    String?
  activeRestrictionId String?
  updatedAt           DateTime @updatedAt

  restrictions Restriction[]
}

/// A ban list, restricted list or points list for a format. Every list NRDB
/// has is kept, current or not; Format.activeRestrictionId says which applies.
model Restriction {
  id             String    @id // e.g. "standard_ban_list_26_03"
  name           String
  dateStart      DateTime?
  /// the most points a deck may spend (points lists only)
  pointLimit     Int?
  /// comma-wrapped card_subtype_ids that are banned outright
  bannedSubtypes String    @default(",")
  updatedAt      DateTime  @updatedAt

  format   Format               @relation(fields: [formatId], references: [id])
  formatId String
  verdicts RestrictionVerdict[]

  @@index([formatId, dateStart])
}

/// What a restriction says about one card.
model RestrictionVerdict {
  /// NRDB card id; not a foreign key, so a card NRDB hasn't published yet
  /// can't break a sync
  cardId  String
  /// "banned" | "restricted" | "points" | "global_penalty" | "universal_faction_cost"
  verdict String
  /// points, or extra influence, for verdicts that carry a number
  value   Int?

  restriction   Restriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)
  restrictionId String

  @@id([restrictionId, cardId, verdict])
  @@index([cardId])
}

model NrdbSync {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // "running" | "success" | "error"
  trigger    String    @default("cli") // "schedule" | "manual" | "cli"
  summary    String? // JSON counts
  error      String?

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// User collection data
// ---------------------------------------------------------------------------

/// How many plain copies of an NRDB printing a user owns.
model CollectionEntry {
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  printing   Printing @relation(fields: [printingId], references: [id], onDelete: Cascade)
  printingId String

  @@id([userId, printingId])
  @@index([printingId])
}

/// A user-defined version of a printing NRDB doesn't track (alt art, promo,
/// foil, language...), with its own quantity. Copies owned of a printing are
/// CollectionEntry.quantity + the sum of its variants' quantities.
model Variant {
  id        String   @id @default(cuid())
  label     String
  notes     String?
  imageUrl  String?
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  printing   Printing @relation(fields: [printingId], references: [id], onDelete: Cascade)
  printingId String

  @@unique([userId, printingId, label])
  @@index([printingId])
}

/// The printing whose art a user wants to see for a card, instead of the one
/// picked for them (the newest printing they own, else the newest printing).
model PreferredPrinting {
  updatedAt DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId     String
  printing   Printing @relation(fields: [printingId], references: [id], onDelete: Cascade)
  printingId String

  @@id([userId, cardId])
  @@index([cardId])
  @@index([printingId])
}

/// Owner lets viewer browse their collection read-only. A row-level grant, so
/// it deliberately isn't modelled through the role-level Permission/Role tables.
model CollectionShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  owner    User   @relation("CollectionShareOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerId  String
  viewer   User   @relation("CollectionShareViewer", fields: [viewerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  viewerId String

  // one grant per pair; also serves owner -> viewers lookups
  @@unique([ownerId, viewerId])
  // "shared with me" listing
  @@index([viewerId])
}

// ---------------------------------------------------------------------------
// Decks
// ---------------------------------------------------------------------------

/// A user's deck. Private to its owner for now (see app/utils/deck.server.ts).
model Deck {
  id              String   @id @default(cuid())
  name            String
  /// copied from the identity; the card browser only shows this side
  sideId          String
  /// "standard" | "startup" | "eternal" (DECK_FORMATS)
  formatId        String   @default("standard")
  /// off: format problems (bans, rotation, points) are warnings, not errors
  requireLegality Boolean  @default(true)
  notes           String?
  /// the NetrunnerDB deck it was imported from
  nrdbUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId                 String
  /// a column rather than a DeckCard, so a deck can't have two
  identity               Card?      @relation("DeckIdentity", fields: [identityCardId], references: [id])
  identityCardId         String?
  /// 0 or 1: whether the identity is reserved from the owner's collection,
  /// like DeckCard.fromCollection
  identityFromCollection Int        @default(0)
  cards                  DeckCard[]

  @@index([userId, updatedAt])
  @@index([identityCardId])
}

/// How many copies of a card a deck has.
model DeckCard {
  quantity       Int
  /// copies reserved from the owner's collection; 0 <= fromCollection <= quantity.
  /// A deck is "filled from the collection" when any card has some.
  fromCollection Int @default(0)

  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  deckId String
  card   Card   @relation(fields: [cardId], references: [id])
  cardId String

  @@id([deckId, cardId])
  // "which of my decks use this card"
  @@index([cardId])
}
